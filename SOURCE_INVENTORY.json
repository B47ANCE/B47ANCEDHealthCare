      "pattern": "medWorks.VERSION=\"([^\"]+)\""
    },
    {
      "path": "README.md",
      "pattern": "^- Version: `([^`]+)`"
    },
    {
      "path": "docs/MASTER_ROADMAP.md",
      "pattern": "^Canonical version: ([0-9][^\\s]+)\\.$"
    },
    {
      "path": "docs/TESTING.md",
      "pattern": "^# medWorks ([^ ]+) testing$"
    },
    {
      "path": "WORKSHOP_DESCRIPTION.txt",
      "pattern": "^\\[b\\]Mod Version: ([^\\[]+)\\[/b\\]$"
    },
    {
      "path": "workshop.txt",
      "pattern": "^description=\\[b\\]Mod Version: ([^\\[]+)\\[/b\\]$"
    },
    {
      "path": "WORKSHOP_CHANGE_NOTE.txt",
      "pattern": "\\A\\[b\\]Version ([^\\[]+)\\[/b\\]"
    },
    {
      "path": "CHANGELOG.md",
      "pattern": "\\A# Changelog\\n\\n## ([^ ]+) - "
    }
  ]
